# Путь к CSV-датасету Walmart. Файл должен содержать Store, Date, Weekly_Sales и признаки.
CSV_PATH=data/Walmart.csv

# Директория, куда сохраняются PDF-отчеты пайплайна.
REPORTS_DIR=build/reports

# 60% фактической истории: самый ранний промежуток, на котором модели учатся.
TRAIN_RATIO=0.6

# 20% фактической истории: промежуток для настройки моделей.
# SARIMAX подбирает параметры по этому участку, GRU использует его для early stopping.
VALIDATION_RATIO=0.2

# 20% фактической истории: тестовый промежуток для честного расчета ошибок.
# Именно по этому участку считаются MAE, MSE, RMSE, MAPE, sMAPE и WAPE в отчете.
TEST_RATIO=0.2

# Seed для воспроизводимого обучения GRU и операций с numpy/torch.
RANDOM_SEED=42

# Будущий прогноз после последней фактической даты.
# Это не процент от истории, а количество недель вперед.
# Например, 12 означает прогноз на 12 недель после конца тестового промежутка.
FORECAST_HORIZON=12

# Сезонный период SARIMAX. Для недельных продаж 52 означает годовую сезонность.
SARIMAX_SEASONAL_PERIOD=52

# Размер скрытого состояния GRU: больше значение - потенциально сложнее модель и дольше обучение.
GRU_HIDDEN_SIZE=64

# Количество GRU-слоев. При значении больше 1 внутри модели включается dropout.
GRU_NUM_LAYERS=2

# Максимальное количество эпох обучения GRU при подборе по validation.
GRU_EPOCHS=100

# Минимальное количество эпох для GRU-модели, которая обучается на всей истории для будущего прогноза.
GRU_FUTURE_MIN_EPOCHS=100

# Learning rate оптимизатора Adam для GRU.
GRU_LEARNING_RATE=0.001

# Длина исторического окна в неделях, которое GRU использует для прогноза следующей точки.
GRU_SEQUENCE_LENGTH=12
