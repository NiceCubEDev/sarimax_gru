# ============================================
# ClusterApp Backend — Environment Variables
# ============================================

# --- Application ---
APP_PORT=8000
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-random-secret-key

# --- PostgreSQL ---
POSTGRES_USER=clusterapp
POSTGRES_PASSWORD=clusterapp
POSTGRES_DB=clusterapp
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://clusterapp:clusterapp@db:5432/clusterapp

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
